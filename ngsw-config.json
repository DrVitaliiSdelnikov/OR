{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js", "/media/*.woff2"]
      }
    },
    {
      "name": "scene",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/scene/**"]
      }
    }
  ]
}
